allow system_server storage_stub_file:dir getattr;

allow system_server adbroot_service:service_manager find;
allow system_server sysfs_devices_system_cpu:file write;
allow system_server device:dir write;

allow system_server shell:unix_stream_socket getopt;

allow system_server audioserver_tmpfs:file write;

allow system_server vndbinder_device:chr_file write;

# Use HALs
hal_client_domain(system_server, hal_lineage_health)
hal_client_domain(system_server, hal_lineage_livedisplay)
hal_client_domain(system_server, hal_lineage_touch)
hal_client_domain(system_server, hal_lineage_powershare)

# Let system server find auxiliary camera properties
get_prop(system_server, vendor_persist_camera_prop)

# Let system server toggle xtra-daemon
set_prop(system_server, xtra_control_prop)

# App lock
add_service(system_server, ax_sandbox_service);

# Game Space
add_service(system_server, game_space_service);

# Freeform
add_service(system_server, freeform_service);

# Theme Engine
add_service(system_server, theme_engine_service);

allow system_server ax_sandbox_vault_file:dir create_dir_perms;
allow system_server ax_sandbox_vault_file:file create_file_perms;

# LinearMotor
add_service(system_server, linearmotor_vibrator_service);
set_prop(system_server, ax_debug_prop)
